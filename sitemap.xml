<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  1行目の <?xml ...?> はXML宣言です（HTMLの DOCTYPE に相当）。
  - version="1.0"   → XML仕様のバージョン（現在も 1.0 が標準）
  - encoding="UTF-8" → このファイルの文字コード（日本語対応）
  この行は必ず先頭に書き、前に空行や空白を入れてはいけません。

  sitemap.xml（サイトマップ）とは？
  Googleなどの検索エンジンに「このサイトにはどんなページがあるか」
  を伝えるためのファイルです。
  検索エンジンのロボット（クローラー）がこのファイルを読み込み、
  各ページを効率よく発見・インデックスしてくれます。

  このファイルは robots.txt の Sitemap: 行から参照されており、
  クローラーが自動的に見つけられるようになっています。

  ============================================================
  ■ URLの書き方について（変更: 拡張子なしに統一）

  変更前は https://flyingdevlab.com/pledge.html のように
  .html 付きで書いていました。しかし Cloudflare Pages は
  .html 付きのURLを 308 リダイレクトで拡張子なしへ飛ばします。

    /pledge.html  →（308）→  /pledge

  つまり変更前のサイトマップは「リダイレクトされるURL」を
  正規URLとして申告している状態でした。壊れてはいませんが、
  申告と実際の配信が食い違っており、正確ではありません。

  ディレクトリを持つページ（ゲーム）は末尾スラッシュ形にします。

    /make10/index.html  →（308）→  /make10/

  各ページの <link rel="canonical"> も同じ形に揃えてあります。
  片方だけ直すと矛盾したシグナルになるため、必ずセットで扱ってください。

  ============================================================
  ■ ここに載せてよいページの条件

  robots.txt に書いたとおり、noindex を指定したページは
  サイトマップに載せません。「インデックスするな」と
  「インデックスしてほしい」を同時に送ることになるためです。

  そのため以下は意図的に除外しています。
    - /tokusho（特定商取引法に基づく表示） … noindex, nofollow
    - /404.html（エラーページ）             … 誤ってインデックスされるため
    - /lab/ 配下（非公開の実験ページ）        … noindex, nofollow
  ============================================================
  <urlset> はサイトマップ全体を囲む親タグです。
  xmlns=...      → 「このファイルはサイトマップの標準形式に従っています」という名前空間宣言。変更不要です。
  xmlns:xhtml=... → 多言語対応（hreflang）のタグを使うために必要な追加の名前空間宣言です。
-->

<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <!-- 
    ============================================================
    TOPページ（英語・メイン）（サイトの入口。最も重要なページ）
    ============================================================
    <url>〜</url> はページ1件分の情報をまとめるブロックです。
    ページが増えるたびにこのブロックを1つ追加します。
  -->
  <url>
    <!-- <loc>：このページの正式なURL（必須）。https:// から始まる絶対URLで書きます。 -->
    <loc>https://flyingdevlab.com/</loc>
    <!-- 
      <lastmod>：このページを最後に更新した日付（YYYY-MM-DD形式）。
      検索エンジンが「最近更新されたか」を判断する参考にします。
      実際に更新したときは日付を変えましょう。

      ⚠️ 内部リンクの書き換えのような表示に影響しない修正では
         日付を動かさないでください。「更新された」という嘘の信号になります。
    -->
    <lastmod>2026-06-26</lastmod>
    <!-- 
      <changefreq>：このページがどのくらいの頻度で更新されるかの目安。
      選択肢: always / hourly / daily / weekly / monthly / yearly / never
      TOPページはアプリ追加・SNS更新が多いので daily（毎日）に設定しています。
      あくまで検索エンジンへのヒントで、クロール頻度を強制するものではありません。 
    -->
    <changefreq>daily</changefreq>
    <!--
      <priority>：サイト内でのこのページの相対的な重要度（0.0〜1.0）。
      1.0 が最高。TOPページなので最高値を設定しています。
      他のページとの相対的な比較にしか使われません。 
    -->
    <priority>1.0</priority>
    <!--
      <xhtml:link>：多言語対応（hreflang）の設定。
      日英を別URLに分離しているため、各言語の実URLを指しています。
      - hreflang="ja"        → 日本語版 /ja/
      - hreflang="en"        → 英語版（このページ＝ルート）
      - hreflang="x-default" → 言語が一致しない場合のフォールバック（英語＝ルート）
      変更: 末尾スラッシュ形（/ja/）が実配信形であることを curl で確認済み。
    -->
    <xhtml:link rel="alternate" hreflang="ja" href="https://flyingdevlab.com/ja/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://flyingdevlab.com/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://flyingdevlab.com/"/>
  </url>

  <!-- 
    ============================================================
    TOPページ（日本語）
    英語メイン（ルート）と対になる日本語版TOP。重要度・更新頻度はルートと同じ設定。
    ============================================================
  -->
  <url>
    <loc>https://flyingdevlab.com/ja/</loc>
    <lastmod>2026-06-26</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
    <!-- hreflang はルートと同じ組み合わせを指定（自分自身=ja、対になる英語=ルート、x-default=英語） -->
    <xhtml:link rel="alternate" hreflang="ja" href="https://flyingdevlab.com/ja/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://flyingdevlab.com/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://flyingdevlab.com/"/>
  </url>

  <!--
    ============================================================
    こども向けゲーム 4本  ← 新規追加
    ============================================================
    無料・広告なし・データ送信なしのブラウザゲームです。
    サイトの主要コンテンツであるため、法的文書より高い priority を設定しています。

    URLは末尾スラッシュ形（/make10/）です。
    /make10/index.html は 308 で /make10/ へリダイレクトされるため、
    index.html を明記すると申告と実配信が食い違います。

    どのゲームも1つのURLで日英を併記しているため、
    hreflang は ja / en / x-default すべて同じURLを指します。

    lastmod は最後にファイルを更新した日です（localStorage の例外処理を追加した日）。
  -->
  <url>
    <loc>https://flyingdevlab.com/make10/</loc>
    <lastmod>2026-08-16</lastmod>
    <!-- ゲーム本体が頻繁に変わることはないため monthly -->
    <changefreq>monthly</changefreq>
    <!-- 主要コンテンツなので法的文書より高い 0.8 -->
    <priority>0.8</priority>
    <xhtml:link rel="alternate" hreflang="ja" href="https://flyingdevlab.com/make10/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://flyingdevlab.com/make10/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://flyingdevlab.com/make10/"/>
  </url>

  <url>
    <loc>https://flyingdevlab.com/cheese-escape-web/</loc>
    <lastmod>2026-08-16</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
    <xhtml:link rel="alternate" hreflang="ja" href="https://flyingdevlab.com/cheese-escape-web/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://flyingdevlab.com/cheese-escape-web/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://flyingdevlab.com/cheese-escape-web/"/>
  </url>

  <url>
    <loc>https://flyingdevlab.com/whack-a-mole/</loc>
    <lastmod>2026-08-16</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
    <xhtml:link rel="alternate" hreflang="ja" href="https://flyingdevlab.com/whack-a-mole/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://flyingdevlab.com/whack-a-mole/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://flyingdevlab.com/whack-a-mole/"/>
  </url>

  <url>
    <loc>https://flyingdevlab.com/pinball/</loc>
    <lastmod>2026-08-16</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
    <xhtml:link rel="alternate" hreflang="ja" href="https://flyingdevlab.com/pinball/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://flyingdevlab.com/pinball/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://flyingdevlab.com/pinball/"/>
  </url>

  <!-- 
    ============================================================
    プライバシーポリシー（サイト共通・個人情報の取り扱い方針のページ）
    ※ このページは日英共通の1URLです（言語切替をJSで行うため）。
    ============================================================ 
  -->
  <url>
    <loc>https://flyingdevlab.com/privacy-policy</loc>
    <!-- 法的文書なので変更頻度は低め。更新したときだけ日付を変えましょう。 -->
    <lastmod>2026-03-10</lastmod>
    <!-- 滅多に変わらないので monthly（月1回程度） -->
    <changefreq>monthly</changefreq>
    <!-- TOPよりは重要度が低いので 0.6（中程度）に設定 -->
    <priority>0.6</priority>
    <!-- このページも日英共通URLのため、すべて同じhref -->
    <xhtml:link rel="alternate" hreflang="ja" href="https://flyingdevlab.com/privacy-policy"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://flyingdevlab.com/privacy-policy"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://flyingdevlab.com/privacy-policy"/>
  </url>

  <!--
    ============================================================
    アプリ別プライバシーポリシー 3本  ← 新規追加
    ============================================================
    App Store に登録している各アプリのポリシーページです。
    流入はほぼアプリ内リンク経由ですが、検索での到達も妨げないため
    各ページに robots="index, follow" を明示し、ここにも掲載します。

    1つのURLで複数言語を切り替えるため、hreflang は同一URLを指します
    （PriceWise は25言語、TechRef は英日、MAKE10 は英日）。

    lastmod は最後にファイルを更新した日です。
    MAKE10 は内容に変更がないため、ポリシーの発効日をそのまま使っています。
  -->
  <url>
    <loc>https://flyingdevlab.com/privacy-policy/make10</loc>
    <lastmod>2026-04-28</lastmod>
    <changefreq>monthly</changefreq>
    <!-- サイト共通ポリシー（0.6）より下、誓い（0.4）より上に位置づけ -->
    <priority>0.5</priority>
    <xhtml:link rel="alternate" hreflang="ja" href="https://flyingdevlab.com/privacy-policy/make10"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://flyingdevlab.com/privacy-policy/make10"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://flyingdevlab.com/privacy-policy/make10"/>
  </url>

  <url>
    <loc>https://flyingdevlab.com/privacy-policy/pricewise</loc>
    <!-- 英語本文を静的HTMLに追加した日（クローラーから見える内容が変わったため） -->
    <lastmod>2026-08-16</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
    <xhtml:link rel="alternate" hreflang="ja" href="https://flyingdevlab.com/privacy-policy/pricewise"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://flyingdevlab.com/privacy-policy/pricewise"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://flyingdevlab.com/privacy-policy/pricewise"/>
  </url>

  <url>
    <loc>https://flyingdevlab.com/privacy-policy/techref</loc>
    <!-- 英語本文を静的HTMLに追加した日（クローラーから見える内容が変わったため） -->
    <lastmod>2026-08-16</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
    <xhtml:link rel="alternate" hreflang="ja" href="https://flyingdevlab.com/privacy-policy/techref"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://flyingdevlab.com/privacy-policy/techref"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://flyingdevlab.com/privacy-policy/techref"/>
  </url>

  <!--
   ============================================================
   こどもたちへの誓い（Flying Dev Lab のポリシー宣言ページ）
   ※ このページも日英共通の1URLです。
   ============================================================
  -->
  <url>
    <loc>https://flyingdevlab.com/pledge</loc>
    <lastmod>2026-03-13</lastmod>
    <!-- 誓いの内容が変わることは少ないため monthly に設定 -->
    <changefreq>monthly</changefreq>
    <!-- TOPより重要度は低いため 0.4（中程度）に設定 -->
    <priority>0.4</priority>
    <!-- このページも日英共通URLのため、すべて同じhref -->
    <xhtml:link rel="alternate" hreflang="ja" href="https://flyingdevlab.com/pledge"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://flyingdevlab.com/pledge"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://flyingdevlab.com/pledge"/>
  </url>

  <!--
    ============================================================
    新しいページを追加するときは、上の <url>〜</url> ブロックを
    コピーして loc / lastmod / hreflang の href を書き換えてください。

    追加前に次の3点を確認してください。
      1. そのページに noindex が付いていないか（付いていれば載せない）
      2. URLが拡張子なし形になっているか（.html を書かない）
      3. そのページの <link rel="canonical"> と同じURLを書いているか

    ⚠️ 404ページ（404.html）はサイトマップに含めません。
    エラーページを登録すると検索エンジンが誤ってインデックスするためです。
    ============================================================
  -->

</urlset>
